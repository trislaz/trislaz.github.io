<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="{{ '/' | relative_url }}">Tristan Lazard</a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.url == '/' %}
          aria-current="page"
        {% endif %}
        >Home</a
      >
      <a
        href="{{ '/publications/' | relative_url }}"
        {% if page.url == '/publications/' %}
          aria-current="page"
        {% endif %}
        >Publications</a
      >
      <a href="{{ site.cv_path | relative_url }}" download>CV</a>
    </nav>
  </div>
</header>
