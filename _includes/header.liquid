<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="{{ '/' | relative_url }}">
      Tristan Lazard
      <span>Researcher in interpretable AI</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.url == '/' %}
          aria-current="page"
        {% endif %}
        >Home</a
      >
      <a
        href="{{ '/publications/' | relative_url }}"
        {% if page.url == '/publications/' %}
          aria-current="page"
        {% endif %}
        >Publications</a
      >
      <a class="cv-link" href="{{ site.cv_path | relative_url }}" download>Download CV</a>
    </nav>
  </div>
</header>
