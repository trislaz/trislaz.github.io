{% capture site_title %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
{% capture page_title %}
  {%- if page.url == '/' -%}
    {{ site_title }}
  {%- else -%}
    {{ page.title }} · {{ site_title }}
  {%- endif -%}
{% endcapture %}
{% assign page_description = page.description | default: site.description %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | strip }}</title>
<meta name="author" content="{{ site_title }}">
<meta name="description" content="{{ page_description }}">

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ site_title }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | strip }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta property="og:description" content="{{ page_description }}">
  {% if site.og_image %}
    <meta property="og:image" content="{{ site.og_image | absolute_url }}">
  {% endif %}
{% endif %}
