---
layout: default
---
<section class="hero">
  <div>
    <p class="eyebrow">{{ page.eyebrow }}</p>
    <h1>Tristan Lazard</h1>
    <p class="hero-summary">{{ page.subtitle }}</p>
    <div class="hero-copy">{{ content }}</div>

    <nav class="profile-links" aria-label="Profile links">
      <a class="primary-link" href="mailto:{{ site.email }}">Email</a>
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
      <a href="https://github.com/{{ site.github_username }}">GitHub</a>
      <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn</a>
      <a href="https://orcid.org/{{ site.orcid_id }}">ORCID</a>
      <a href="{{ site.cv_path | relative_url }}" download>CV (PDF)</a>
    </nav>
  </div>

  <aside class="profile-card">
    <img src="{{ site.profile_image | prepend: '/assets/img/' | relative_url }}" alt="Portrait of Tristan Lazard">
    <p class="profile-caption">Microsoft Research Health Futures · Cambridge, UK</p>
  </aside>
</section>

{% if page.news %}
  <section class="content-section" id="news">
    <header class="section-heading">
      <h2>Recent updates</h2>
      <p>New papers, research milestones, and professional updates.</p>
    </header>
    {% include news.liquid %}
  </section>
{% endif %}
