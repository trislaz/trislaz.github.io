---
layout: default
---
<section class="profile">
  <img
    class="profile-photo"
    src="{{ site.profile_image | prepend: '/assets/img/' | relative_url }}"
    alt="Portrait of Tristan Lazard"
  >
  <h1>Tristan Lazard</h1>
  <p class="intro">{{ page.subtitle }}</p>

  <nav class="profile-links" aria-label="Profile links">
    <a href="mailto:{{ site.email }}" aria-label="Email" title="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7"></path>
      </svg>
    </a>
    <a
      href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
      aria-label="Google Scholar"
      title="Google Scholar"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
        ></path>
      </svg>
    </a>
    <a href="https://github.com/{{ site.github_username }}" aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>
    <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" aria-label="LinkedIn" title="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M19 0H5a5 5 0 0 0-5 5v14a5 5 0 0 0 5 5h14a5 5 0 0 0 5-5V5a5 5 0 0 0-5-5zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm15.11 13.02H16.9v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28z"
        ></path>
      </svg>
    </a>
    <a href="https://orcid.org/{{ site.orcid_id }}" aria-label="ORCID" title="ORCID">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"
        ></path>
      </svg>
    </a>
    <a href="{{ site.cv_path | relative_url }}" download aria-label="Download CV" title="Download CV">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 2.5h8l4 4v15H6zM14 2.5v4h4M9 12h6M9 15h6M9 18h4"></path>
      </svg>
    </a>
  </nav>
</section>

<div class="about-copy">{{ content }}</div>

{% if page.news %}
  <section class="content-section" id="news">
    <h2>Recent updates</h2>
    {% include news.liquid %}
  </section>
{% endif %}
